# Copier en .env.local (développement) ou .env.production (mise en ligne).
# L'URL et la clé « anon » sont publiques par conception : la sécurité repose sur les
# droits (Row Level Security) définis dans supabase/migrations/0001_init.sql.
# Ne jamais mettre ici la clé « service_role ».
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_COMMUNE_ID=00000000-0000-4000-8000-000000000001
# Facultatif : numéro qui reçoit les demandes par SMS quand Internet ne passe pas
# (cellule de crise de la commune). Sans numéro, l'habitant choisit le destinataire.
VITE_SMS_CELLULE=
# Facultatif : 1 = vrai code de connexion envoyé par SMS (fournisseur SMS réglé dans Supabase,
# voir docs/SMS.md). Sans cette ligne, n'importe quel code à 6 chiffres passe (démo).
VITE_CONNEXION_SMS=
