# Copier en .env.local (développement) ou .env.production (mise en ligne).
# L'URL et la clé « anon » sont publiques par conception : la sécurité repose sur les
# droits (Row Level Security) définis dans supabase/migrations/0001_init.sql.
# Ne jamais mettre ici la clé « service_role ».
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_COMMUNE_ID=00000000-0000-4000-8000-000000000001
# Facultatif : numéro qui reçoit les demandes par SMS quand Internet ne passe pas
# (cellule de crise de la commune). Sans numéro, l'habitant choisit le destinataire.
VITE_SMS_CELLULE=
# Connexion sans mot de passe (docs/CONNEXION.md) : code à 6 chiffres reçu par e-mail (par défaut).
# 1 = vrai code envoyé par e-mail (envoi d'e-mails réglé dans Supabase). Sans cette ligne : démo,
# n'importe quel code à 6 chiffres passe.
VITE_CONNEXION_EMAIL=
# Plus tard, si besoin : code par SMS à la place de l'e-mail (payant, docs/SMS.md).
# VITE_CONNEXION_PAR=sms et VITE_CONNEXION_SMS=1. Tant que ce n'est pas réglé, le SMS n'apparaît nulle part.
VITE_CONNEXION_PAR=
VITE_CONNEXION_SMS=
